/*
  ==============================================================================

    This file contains the basic framework code for a JUCE plugin editor.

  ==============================================================================
*/

#pragma once

#include <JuceHeader.h>
#include "PluginProcessor.h"
#include "ParameterIDs.hpp"

// -----------------------------------------------------------------------------------------------------------------
// APC UI KIT (opt-in). Off unless CMake defines APC_UI_KIT=1 (option {{PLUGIN_NAME_LOWER}}_UI_KIT in CMakeLists.txt),
// so existing WebView plugins stay valid. Needs: PluginProcessor owns `apc::web::ApcBackend apcBackend;` (stores, params,
// license, update - filled in the processor, see .agents/guides/ui-kit-native.md). Walk-through: templates/webview/README.md.
// -----------------------------------------------------------------------------------------------------------------
#if APC_UI_KIT
 #include "apc/juce/ApcWebBridge.h"
#endif

//==============================================================================
/**
*/
class {{PLUGIN_NAME}}AudioProcessorEditor  : public juce::AudioProcessorEditor
{
public:
    {{PLUGIN_NAME}}AudioProcessorEditor ({{PLUGIN_NAME}}AudioProcessor&);
    ~{{PLUGIN_NAME}}AudioProcessorEditor() override;

    //==============================================================================
    void paint (juce::Graphics&) override;
    void resized() override;

private:
    {{PLUGIN_NAME}}AudioProcessor& audioProcessor;

    // UI layout contract (from Design/ui-map.json — do not improvise)
    static constexpr int    kPlateW      = {{PLATE_W}};        // authored window width  (px)
    static constexpr int    kPlateH      = {{PLATE_H}};        // authored window height (px)
    static constexpr double kAspect      = (double) kPlateW / (double) kPlateH;
    static constexpr double kMinUiScale  = {{MIN_SCALE}};
    static constexpr double kMaxUiScale  = {{MAX_SCALE}};

    // Host-initiated resizes bypass ComponentBoundsConstrainer (known JUCE
    // trap). Re-assert the aspect so the webview can never letterbox.
    void snapWindowToAspect();

    // In-page resize grip state (apc-fit.js sends accumulated deltas)
    int gripStartW = 0;
    int gripStartH = 0;

    void setUiScaleAndSize (double s);

    // ═══════════════════════════════════════════════════════════════════
    // CRITICAL: Member Declaration Order (Prevents DAW Crashes)
    // ═══════════════════════════════════════════════════════════════════
    //
    // C++ destroys members in REVERSE order of declaration.
    // WebView references relays via .withOptionsFrom()
    //
    // CORRECT ORDER: Relays → WebView → Attachments
    //
    // This ensures WebView is destroyed BEFORE the relays it references,
    // preventing access to freed memory (segfault/crash).
    //
    // See: .claude/troubleshooting/resolutions/webview-member-order-crash.md
    // ═══════════════════════════════════════════════════════════════════

    // 1. PARAMETER RELAYS FIRST (no dependencies, destroyed last)
    // Relays are direct member variables - initialized with parameter ID
    juce::WebSliderRelay {{PARAMETER_NAME}}Relay { ParameterIDs::{{PARAMETER_ID}} };
    {{ADDITIONAL_RELAYS}}

#if APC_UI_KIT
    // 1b. UI KIT BRIDGE (opt-in). After the relays, BEFORE the webView: it is destroyed AFTER the webView whose
    // native-function lambdas call into it (same rule as the relays). The backend itself lives in the processor.
    apc::web::ApcBridge apcBridge { audioProcessor.apcBackend };
#endif

    // 2. WEBVIEW SECOND (depends on relays, destroyed middle)
    std::unique_ptr<juce::WebBrowserComponent> webView;

    // 3. PARAMETER ATTACHMENTS LAST (depend on relays + parameters, destroyed first)
    {{PARAMETER_ATTACHMENTS}}

    // Resource provider function
    std::optional<juce::WebBrowserComponent::Resource> getResource (const juce::String& url);

    // Helper functions for resource provider
    static juce::ZipFile* getZipFile();
    static const char* getMimeForExtension (const juce::String& extension);
    static juce::String getExtension (juce::String filename);
    static auto streamToVector (juce::InputStream& stream);

    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR ({{PLUGIN_NAME}}AudioProcessorEditor)
};
