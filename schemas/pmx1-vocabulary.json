{
  "schema": "apc-vocabulary/1.0",
  "taxonomy": "PMX/1",
  "version": "1.1.0",
  "frozen": "2026-10-24",
  "summary": "Machine-readable PMX/1 vocabulary (decision P-10). Files store the lowercase SLUG, never the display label and never an index (P-04). Arrays are ordered and APPEND-ONLY: entries may be added at the end (with a later 'since'), never renamed, removed or reordered. 'label' is display-only and may be re-worded; 'aliases' are accepted on read (the linter warns) and normalised to the slug on write.",
  "rules": {
    "store": "slug",
    "slug_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "append_only": true,
    "order_is_value_for_axes": true,
    "mandatory_axes_for_factory": ["bri", "war", "agg", "wid", "dep", "mov"],
    "moods": { "min": 1, "max": 2 },
    "tags": { "max": 8, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "unknown_values": "Closed lists (category, axes, articulation, temporal, moods) reject unknown slugs in factory content. Genres, subcategories and tags may be extended per product; unknown ones are linted as warnings."
  },

  "categories": [
    { "slug": "pad",        "label": "Pad",        "code": "PD", "group": "instrument", "since": "1.0.0", "subcategories": ["analog", "strings", "choir", "shimmer", "dark", "noise-bed", "crystal", "evolving", "air"] },
    { "slug": "bass",       "label": "Bass",       "code": "BA", "group": "instrument", "since": "1.0.0", "subcategories": ["sub", "growl", "reese", "analog", "plucked", "driven", "wobble", "mono"] },
    { "slug": "lead",       "label": "Lead",       "code": "LD", "group": "instrument", "since": "1.0.0", "subcategories": ["solo", "brassy", "vocal", "aggressive", "soft", "sync", "glide"] },
    { "slug": "keys",       "label": "Keys",       "code": "KY", "group": "instrument", "since": "1.0.0", "subcategories": ["e-piano", "organ", "clav", "synth-keys", "glass-keys", "hollow"] },
    { "slug": "bells",      "label": "Bells",      "code": "BE", "group": "instrument", "since": "1.0.0", "subcategories": ["bell", "mallet", "chime", "carillon", "kalimba", "glass", "crystal"] },
    { "slug": "pluck",      "label": "Pluck",      "code": "PL", "group": "instrument", "since": "1.0.0", "subcategories": ["pluck", "harp", "pizzicato", "synth-pluck", "short"] },
    { "slug": "impact",     "label": "Impact",     "code": "IM", "group": "instrument", "since": "1.0.0", "subcategories": ["braam", "hit", "boom", "sub-drop", "slam", "stinger"] },
    { "slug": "percussion", "label": "Percussion", "code": "DR", "group": "instrument", "since": "1.0.0", "subcategories": ["drum", "tom", "kick", "snare", "hihat", "tribal", "metallic", "noise-perc"] },
    { "slug": "drone",      "label": "Drone",      "code": "DN", "group": "instrument", "since": "1.0.0", "subcategories": ["sub-drone", "dark-ambient", "industrial", "organic", "machine", "ritual", "horror"] },
    { "slug": "sfx",        "label": "SFX",        "code": "SC", "group": "instrument", "since": "1.0.0", "subcategories": ["riser", "downlifter", "whoosh", "texture", "sweep", "reverse", "transition"] },
    { "slug": "voice",      "label": "Voice",      "code": "VC", "group": "instrument", "since": "1.0.0", "subcategories": ["choir", "vocal", "whisper", "formant"] },

    { "slug": "reverb",      "label": "Reverb",        "code": "RV", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["plate", "hall", "room", "spring", "shimmer", "ambience", "gated", "reverse"] },
    { "slug": "delay",       "label": "Delay",         "code": "DL", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["tape", "digital", "ping-pong", "analog", "multi-tap", "slapback", "ducking"] },
    { "slug": "modulation",  "label": "Modulation",    "code": "MD", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["chorus", "flanger", "phaser", "tremolo", "vibrato", "rotary", "ring-mod"] },
    { "slug": "dynamics",    "label": "Dynamics",      "code": "DY", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["compressor", "limiter", "gate", "expander", "transient", "de-esser", "multiband"] },
    { "slug": "eq-filter",   "label": "EQ / Filter",   "code": "EQ", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["eq", "filter", "low-cut", "high-cut", "formant", "resonator", "tilt"] },
    { "slug": "distortion",  "label": "Distortion",    "code": "DS", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["saturation", "overdrive", "fuzz", "bitcrush", "waveshaper", "tape-sat", "amp"] },
    { "slug": "pitch",       "label": "Pitch",         "code": "PI", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["pitch-shift", "harmonizer", "detune", "octaver", "vocoder", "formant-shift"] },
    { "slug": "utility",     "label": "Utility",       "code": "UT", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["gain", "stereo-width", "mid-side", "pan", "mono-maker"] },
    { "slug": "creative-fx", "label": "Creative FX",   "code": "CF", "group": "effect", "since": "1.1.0", "appended": true, "subcategories": ["granular", "glitch", "stutter", "spectral", "freeze", "multi-fx"] }
  ],

