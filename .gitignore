# --- APC IGNORES ---

# plugin folder
plugins/CloudWash/Org_Code

# plugin sync scratch dirs / oversized assets (source of truth: ../apc_plugins)
plugins/*/_state_backups/
plugins/*/_source/
plugins/*/_design/
plugins/*/status.json.bak*
plugins/NoizeMeter/Design/test-tones/
plugins/GrooXtract/Models/htdemucs_fp16weights.*

# _tools folder
_tools/DebugView/
_tools/clap-validator-bin/

# Design Libraries (examples)
design_library/_exclude/

# Build Artifacts (The Dirty Zone)
build/
cmake-build-*/
.vs/
out/
*.obj
*.tlog
*.pdb
*.idb
*.exe
*.vst3
*.lib
*.exp

# github
github/

# User Specific
PRESS_RELEASE.md
.vscode/
*.user
*.suo
nul

# plans (local only — never publish)
plans/

# Machine-local APC setup (commit apc.config.example.json instead)
apc.config.json
apc.config.json.bak*

# Backups written by the Hub's "save to library" (design-system.json.bak)
design_library/**/*.bak

# Per-user agent host settings (permissions, enabled MCP servers)
.claude/settings.local.json
.agent/settings.local.json
.kilocode/settings.local.json

# Local Codex orchestration smoke/usage logs
.tmp/

# Release artifacts (keep release/README.md tracked)
release/**
!release/README.md

# Legacy ship folder (replaced by release/). Ignore leftovers.
dist/

# System
.DS_Store
Thumbs.db

# Logs & Crash Reports
logs/
APC_CRASH_REPORT.txt
build_log.txt
*_log.txt
cloudwash_crash_log.txt

# Backups
_backups/
# python caches
__pycache__/
*.pyc

# apc audio gate output
plugins/*/_audio-report.json

# Local agent MCP wiring generated by scripts/install-open-design-mcp.ps1
# (machine-specific paths - keeps the repo portable, see docs/open-design-mcp.md)
.mcp.json
.cursor/mcp.json
.codex/config.toml

